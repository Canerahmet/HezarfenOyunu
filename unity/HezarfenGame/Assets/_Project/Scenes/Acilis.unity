--- !u!114 &2014309395
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2014309393}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.85, b: 0.74, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 9
    m_MaxSize: 16
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "HEZARFEN \xB7 1632\n\n\u2014 VER\u0130 VE VARLIK ATIFLARI \u2014\n\nHarita
    verisi: \xA9 OpenStreetMap katk\u0131c\u0131lar\u0131.\nOpen Database License
    (ODbL) alt\u0131nda kullan\u0131lm\u0131\u015Ft\u0131r.\nK\u0131y\u0131 \xE7izgisi
    ve topografya bu veriden t\xFCretilmi\u015Ftir.\n\nY\xFCkseklik verisi: kamu
    eri\u015Fimli DEM kaynaklar\u0131.\n\nHDRI ve doku: Poly Haven (CC0).\nTaban
    insan geometrisi: Blender Studio, Human Base Meshes (CC0).\nK\u0131yafet referans\u0131:
    Claes R\xE5lamb, R\xE5lambska dr\xE4ktboken (1657), kamu mal\u0131.\n\nMotor:
    Unity (HDRP). Modelleme: Blender.\n\n\u2014 TAR\u0130HSEL KAYNAK\xC7A \u2014\n\n\u015Eehir
    1632 \u0130stanbul'una g\xF6re kuruldu ve her \xF6ge bir\nKADEME ta\u015F\u0131r:\n\n 
    T1  belgeli \u2014 kaynakta do\u011Frudan yaz\u0131yor\n  T2  yeniden kurgu \u2014
    tipoloji belgeli, \xF6l\xE7\xFC de\u011Fil\n  T3  t\u0131n\u0131 \u2014 d\xF6nem
    duygusu, belge de\u011Fil\n\nBa\u015Fl\u0131ca kaynaklar:\n\n  Evliya \xC7elebi,
    Seyahatn\xE2me 1. cilt\n    (1638 Esnaf Alay\u0131; Hezarfen ve Lagari anlat\u0131lar\u0131)\n 
    K\xE2tip \xC7elebi\n  TDV \u0130sl\xE2m Ansiklopedisi\n  \u0130stanbul Kad\u0131
    Sicilleri (\u0130SAM/\u0130SAR)\n  M\xFChimme ve narh defterleri\n  BOA, A.DVN
    nr. 25/47 \u2014 kahvehane ferman\u0131, 2 Eyl\xFCl 1633\n  Ko\xE7 \xDCniversitesi,
    \u0130stanbul Surlar\u0131\n  Louis Mitler, The Genoese in Galata 1453\u20131682\n 
    Robert Dankoff, An Ottoman Mentality\n\nAyr\u0131nt\u0131l\u0131 kaynak\xE7a
    ve her \xF6genin dayana\u011F\u0131 i\xE7in:\ndocs/RESEARCH.md\n\n\u2014 D\xDCR\xDCSTL\xDCK
    NOTU \u2014\n\nHezarfen Ahmed \xC7elebi'nin u\xE7u\u015Fu YALNIZ Evliya \xC7elebi'de\nge\xE7er;
    ba\u015Fka kay\u0131tla do\u011Frulanmaz. Kese alt\u0131n ihsan\u0131n\u0131n\nmali
    kay\u0131tlarda izi yoktur. Gereken s\xFCz\xFClme oran\u0131 (~55:1)\nmodern
    delta kanad\u0131n (~15:1) \xE7ok \xFCst\xFCndedir. Kaynaklar\u0131n\n\xE7o\u011Fu
    1632 der, baz\u0131lar\u0131 1638.\n\nBu oyun o rivayeti oynat\u0131r; belge
    diye sunmaz."
