  m_EditorClassIdentifier: Hezarfen.Runtime::Hezarfen.Core.HistoricalTag
  tier: 2
  sourceNote: 'Sur ile yerlesim arasindaki kirsal doku (T2, taslak). Konumu kaynaktan
    gelen tekil yapi YOK; donemin yapi TURLERI konuldu: kapi yollari, bostan parselleri,
    meyvelik. Yol guzergahi en-az-egim yolundan (olcum), parsel sinirlari bizim (uydurma).
    Karar ADR 0074 (A).'
