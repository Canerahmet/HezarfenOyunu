  m_Script: {fileID: 11500000, guid: 6e60ea5c86c339049bcad6a3d68c5042, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hezarfen.Runtime::Hezarfen.Core.HistoricalTag
  tier: 2
  sourceNote: "1632'de VARDIR (Istanbul'un ilki Fatih Camii, 1470) ama YAYGIN DEGILDIR:
    yayginlasmasi 18. yy sonu-19. yy basidir. 1632'de muvakkithane MAHALLE MESCIDINE
    DEGIL, SELATIN CAMISINE aittir \u2014 YERLESTIRME KURALI budur. Bicim: 'bir iki
    odadan buyuk olmayan', cami avlusunda, buyuk sebekeli pencereli. 17. yy muvakkitleri:
    Ahmed Naksi Efendi (Suleymaniye), Muneccimek Mehmed (Fatih)."
