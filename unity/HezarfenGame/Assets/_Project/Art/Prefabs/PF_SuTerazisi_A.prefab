  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e60ea5c86c339049bcad6a3d68c5042, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hezarfen.Runtime::Hezarfen.Core.HistoricalTag
  tier: 2
  sourceNote: "'Kule seklinde kagir yapi': su tepedeki HAZNEYE cikar, oradan kunklerle
    bir sonraki teraziye gider; amac fazla basincin kunkleri patlatmasini onlemektir.
    1632'de VARDIR \u2014 Kirkcesme tesisleri (Kanuni, Sinan, ~1563) 55 km'lik hat
    boyunca su terazileri tasir. Vikipedi 'Su terazisi (yapi)'; TDV 'Kirkcesme Sulari'."
