  m_Script: {fileID: 11500000, guid: 6e60ea5c86c339049bcad6a3d68c5042, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hezarfen.Runtime::Hezarfen.Core.HistoricalTag
  tier: 1
  sourceNote: "1632'DE ACIK. IV. Murad'in emriyle yapilan 1638 esnaf sayiminda Istanbul'da
    300 BOZAHANE ve ~1100 bozaci vardir; ayrica ACI BOZA ureten ~40 esnaf. Aci boza
    sarhos edecek kadar alkolludur ve bozahaneler IV. MURAD DONEMINDE KAPATILMISTIR
    (1623-1640) \u2014 kahvehaneden sonra oyunun IKINCI ZAMAN ISARETI. Bicim tipolojik."
