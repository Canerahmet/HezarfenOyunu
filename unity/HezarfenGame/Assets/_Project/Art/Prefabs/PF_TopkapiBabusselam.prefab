  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6e60ea5c86c339049bcad6a3d68c5042, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Hezarfen.Runtime::Hezarfen.Core.HistoricalTag
  tier: 1
  sourceNote: "Topkapi Sarayi BABUSSELAM (Orta Kapi) \u2014 CIFTE KONIK KULAHLI kapi.
    Kuleler 1632'de VARDIR; tartisma yalnizca kimin eklediginedir: Gulru Necipoglu
    kulelerin FATIH doneminde duvarlarla birlikte yapildigini dusunur, yaygin gorus
    KANUNI'nin Avrupa seferindeki gozlemlerine baglar. Iki ihtimal de 1632'den oncedir,
    yani soru modeli etkilemez. Kapi ikinci avluya (Divan Meydani) acilir ve saraya
    girerken atindan inilmeyen tek kisi padisahtir. OLCU YOK: kutle **D3**; sayilan
    deger IKI kuledir. RESEARCH.md 5.7, ADR 0040"
